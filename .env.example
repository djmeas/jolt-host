# Admin dashboard password (required for /admin)
# Set one of:
#   JOLT_ADMIN_PASSWORD=your-secret-password
#   NUXT_JOLTHOST_ADMIN_PASSWORD=your-secret-password

# --- Origin isolation (required to serve uploaded sites) -----------------------
# Uploaded HTML is untrusted executable content, so it is served from a separate
# registrable domain. The app origin and the hosted base must differ; use wildcard
# DNS (*.sites.example.net -> this service) and a wildcard TLS certificate.
# Development defaults are http://localhost:3000 and http://sites.localhost:3000. A loopback pair
# (localhost / *.localhost / 127.0.0.1 / ::1) may use http even in production, which is how local
# `docker compose up` and `npm run preview` work; any public origin must use https.
# JOLT_APP_ORIGIN=https://host.example.com
# JOLT_SITE_BASE_ORIGIN=https://sites.example.net
# Trust X-Forwarded-Host / X-Forwarded-For / CF-Connecting-IP from a reverse proxy.
# JOLT_TRUST_PROXY=true

# Secret for signing view/unlock cookies and tokens. Required (and must not be the
# built-in default) in production when site data is enabled.
# JOLT_VIEW_SECRET=your-view-secret

# Secret for signing site data-admin cookies. Required for the site data feature;
# keep it separate from JOLT_VIEW_SECRET.
# JOLT_DATA_SESSION_SECRET=your-data-session-secret

# Show the "Data API" checkbox on the public upload form so uploaders can opt
# their site in at publish time instead of enabling it later from the dashboard
# (which stays available either way). Default true; set to false to hide the
# checkbox and reject Data API opt-ins on uploads.
# ENABLE_DATA_API_TOGGLE=false

# --- AI Builder (optional) -----------------------------------------------------
# Lets signed-in accounts with admin-enabled Build Mode generate static sites.
# Configure provider settings in Admin -> AI; these variables are field-by-field
# fallbacks when the corresponding admin setting is unset or cleared.
# Server-side only: this key is never sent to browsers, logs, or prompts.
# Stored admin keys are AES-256-GCM encrypted using a scrypt-derived key from
# JOLT_ADMIN_SECRET, then JOLT_VIEW_SECRET, then the development default.
# Keep a strong, stable secret: rotating it requires replacing the stored key.
# Missing/invalid effective configuration returns 503 for every /api/ai/** route.
# Requires HTTPS (loopback HTTP allowed); no URL credentials, query, or fragment.
# JOLT_AI_API_KEY=your-provider-key
# JOLT_AI_BASE_URL=https://your-gateway.example.com/v1
# JOLT_AI_MODEL=your-model-id
# OpenCode Go example: JOLT_AI_BASE_URL=https://opencode.ai/zen/go/v1
# and JOLT_AI_MODEL=kimi-k2.7-code (use the bare API model ID, never
# the OpenCode CLI identifier such as opencode-go/kimi-k2.7-code).
# Jolt Host currently supports only OpenAI-compatible /chat/completions;
# do not choose a Go model documented with /responses or /messages.
# Kill switch for the AI Builder. Disabled only by the literal string "false";
# otherwise enabled when effective settings are valid; users still need Build Mode.
# ENABLE_AI_BUILDER=false

# Optional: secret for signing admin session cookie (defaults to JOLT_VIEW_SECRET)
# JOLT_ADMIN_SECRET=your-admin-secret

# Optional: secret for signing web session cookie (allows uploads via web form)
# JOLT_WEB_SECRET=your-web-secret

# Enable login and require a logged-in account to publish
# files, HTML, or Markdown (default false). Web session cookies and admin API tokens
# cannot publish when enabled.
# REGISTERED_USERS_ONLY=true

# Allow visitors to create accounts when REGISTERED_USERS_ONLY=true (default true).
# Set to false to allow only existing or admin-created accounts to log in.
# ENABLE_REGISTRATION=false

# Show the full upload homepage (default true). Set to false for a minimal
# visitor homepage with only the Jolt Host logo and GitHub link.
# Logged-in registered users still see the upload form at /.
# ENABLE_LANDING_PAGE=false

# Secret for signing registered-user session cookies (set a unique value in production).
# JOLT_USER_SECRET=your-user-secret

# Optional: max upload size in bytes (default 25MB). Example: 52428800 for 50MB.
# NUXT_JOLTHOST_UPLOAD_MAX_BYTES=26214400 (25MB)

# Cloudflare Turnstile (optional – adds captcha to the web upload and paste forms)
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
# NUXT_TURNSTILE_SECRET_KEY=your-secret-key

# Show Buy Me a Coffee badge on the home page (optional, default hidden)
# SHOW_BUYMEACOFFEE_LINK=true

# Cloudflare Web Analytics (optional – enables beacon script on all pages)
# Get your token at https://dash.cloudflare.com/?to=/:account/web-analytics
# CF_BEACON_TOKEN=your-token

# Support email shown in the Privacy Policy contact section (optional – hides section if unset)
# SUPPORT_EMAIL=support@example.com
