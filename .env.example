# Admin dashboard password (required for /admin)
# Set one of:
#   JOLT_ADMIN_PASSWORD=your-secret-password
#   NUXT_JOLTHOST_ADMIN_PASSWORD=your-secret-password

# Optional: secret for signing admin session cookie (defaults to JOLT_VIEW_SECRET)
# JOLT_ADMIN_SECRET=your-admin-secret

# Optional: secret for signing web session cookie (allows uploads via web form)
# JOLT_WEB_SECRET=your-web-secret

# Enable login and require a logged-in account to publish
# files, HTML, or Markdown (default false). Web session cookies and admin API tokens
# cannot publish when enabled.
# REGISTERED_USERS_ONLY=true

# Allow visitors to create accounts when REGISTERED_USERS_ONLY=true (default true).
# Set to false to allow only existing or admin-created accounts to log in.
# ENABLE_REGISTRATION=false

# Show the full upload homepage (default true). Set to false for a minimal
# visitor homepage with only the Jolt Host logo and GitHub link.
# Logged-in registered users still see the upload form at /.
# ENABLE_LANDING_PAGE=false

# Secret for signing registered-user session cookies (set a unique value in production).
# JOLT_USER_SECRET=your-user-secret

# Optional: max upload size in bytes (default 25MB). Example: 52428800 for 50MB.
# NUXT_JOLTHOST_UPLOAD_MAX_BYTES=26214400 (25MB)

# Cloudflare Turnstile (optional – adds captcha to the web upload and paste forms)
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
# NUXT_TURNSTILE_SECRET_KEY=your-secret-key

# Show Buy Me a Coffee badge on the home page (optional, default hidden)
# SHOW_BUYMEACOFFEE_LINK=true

# Cloudflare Web Analytics (optional – enables beacon script on all pages)
# Get your token at https://dash.cloudflare.com/?to=/:account/web-analytics
# CF_BEACON_TOKEN=your-token

# Support email shown in the Privacy Policy contact section (optional – hides section if unset)
# SUPPORT_EMAIL=support@example.com
